# Para o caso de querer utilizar um .env, ao inves dos parametros configurados em app/core/config.py, fazendo os ajustes se necessário. Nenhuma variável aqui é obrigatória —
# todos os valores abaixo já são o default em app/core/config.py.

# --- servidor ---
PORT=5050

# --- fonte dos eventos ---
# "local": lê JSONL de LOCAL_EVENTS_DIR (padrão, sem dependências externas)
# "s3": lê via boto3 de um bucket real ou do LocalStack (ver AWS_ENDPOINT_URL)
EVENT_SOURCE=local
LOCAL_EVENTS_DIR=data/events
S3_BUCKET=spark-job-events
S3_PREFIX=events/
# Apontar para o LocalStack ao rodar make dev-aws; deixar vazio para AWS real.
AWS_ENDPOINT_URL=
AWS_REGION=us-east-1

# --- loop de ingestão ---
REFRESH_INTERVAL_SECONDS=60
LOOKBACK_HOURS=12

# --- algoritmo de scoring (sistema de pontos) ---
WEIGHT_RECENT=3
WEIGHT_MID=2
WEIGHT_OLD=1
WINDOW_RECENT_H=1.0
WINDOW_MID_H=6.0
COURTESY_POINTS=5
TOP_K=3
